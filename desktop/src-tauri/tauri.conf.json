{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HomeSentry",
  "version": "0.5.0",
  "identifier": "com.vsletten.homesentry",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Home network security, on your own machine",
    "copyright": "\u00a9 2026 Victor Sletten",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../dist/homesentry-backend/": "backend/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  }
}
